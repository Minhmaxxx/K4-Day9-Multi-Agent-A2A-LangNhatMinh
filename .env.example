# LM Studio local server. Do not commit the real .env file.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Copy the exact model identifier displayed in LM Studio's Developer tab after
# loading a permitted model (at most 10B parameters), for example Gemma 3 1B.
LMSTUDIO_MODEL=

# Leave blank unless you explicitly enable "Require Authentication" in LM Studio.
LMSTUDIO_API_TOKEN=
